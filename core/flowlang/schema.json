{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyt.dev/flow.schema.json",
  "title": "Flow DSL (*.flow.yaml), version 1",
  "type": "object",
  "required": ["version", "id", "name", "flow"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "nodes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "flow": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)?(\\s*->\\s*[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)?)+$" }
    },
    "modes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$" },
      "additionalProperties": { "$ref": "#/$defs/mode" }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "derivedFrom": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "overrides": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$" },
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "contextSpec": {
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "arms": {
      "description": "A branch node's outgoing arms (PIVOT-PLAN §5.3). Evaluated top to bottom; the FIRST arm whose `when` holds is the one taken, and an arm with no `when` is the default. Exactly one arm activates, so exactly one downstream path runs.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["to"],
        "additionalProperties": false,
        "properties": {
          "when": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "label": { "type": "string" }
        }
      }
    },
    "limits": {
      "description": "Per-node retry and timeout (PIVOT-PLAN §5.2). attempts: how many tries this node's model call gets; backoffMs: the base backoff between them; timeoutMs: how long ONE attempt may take before it is aborted and retried (0 disables the timer). Absent fields fall back to the run's configured defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "backoffMs": { "type": "integer", "minimum": 0 },
        "timeoutMs": { "type": "integer", "minimum": 0 }
      }
    },
    "toolCeiling": {
      "description": "The hard limit a node's tool grant lives inside: a toolset id (repo-write), a selector (effects:read, provider:mcp, trust:trusted, *), a tool id, or a list of any of those. Absent means the ceiling is exactly the static grant.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "worker": {
      "type": "object",
      "required": ["provider", "model"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "templateNode": {
      "type": "object",
      "required": ["use"],
      "additionalProperties": false,
      "properties": {
        "use": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "parent": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "expose": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "limits": { "$ref": "#/$defs/limits" },
        "instructions": { "type": "string" },
        "goal": { "type": "string" },
        "category": { "type": "string" },
        "effort": { "enum": ["low", "medium", "high"] },
        "evalType": { "enum": ["plan", "step", "final"] },
        "language": { "type": "string" },
        "contextSpec": { "$ref": "#/$defs/contextSpec" },
        "worker": { "$ref": "#/$defs/worker" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "toolCeiling": { "$ref": "#/$defs/toolCeiling" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "requiresApproval": { "type": "boolean" },
        "approveToolCalls": { "type": "boolean" }
      }
    },
    "rawNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["input", "output", "aiStep", "agentTask", "orchestrator", "branch", "loop"] },
        "kind": { "enum": ["user", "ai"] },
        "parent": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "expose": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "limits": { "$ref": "#/$defs/limits" },
        "role": { "type": "string" },
        "system": { "type": "string" },
        "text": { "type": "string" },
        "goal": { "type": "string" },
        "category": { "type": "string" },
        "effort": { "enum": ["low", "medium", "high"] },
        "evalType": { "enum": ["plan", "step", "final"] },
        "language": { "type": "string" },
        "minNodes": { "type": "integer", "minimum": 1 },
        "maxNodes": { "type": "integer", "minimum": 1 },
        "arms": { "$ref": "#/$defs/arms" },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "until": { "type": "string", "minLength": 1 },
        "maxCost": { "type": "number", "minimum": 0 },
        "maxTokens": { "type": "integer", "minimum": 0 },
        "contextSpec": { "$ref": "#/$defs/contextSpec" },
        "worker": { "$ref": "#/$defs/worker" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "toolCeiling": { "$ref": "#/$defs/toolCeiling" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array" },
        "box": {
          "type": "object",
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "requiresApproval": { "type": "boolean" },
        "approveToolCalls": { "type": "boolean" }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/templateNode" },
        { "$ref": "#/$defs/rawNode" }
      ]
    }
  }
}
