{
  "name": "flyt",
  "version": "2.0.5",
  "description": "Flyt — AI-first orchestration with file-backed plugin stacks",
  "author": "olaaxe",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#kernel": "./kernel/dist/index.js",
    "#kernel/*": "./kernel/dist/*"
  },
  "scripts": {
    "build:kernel": "tsc -p kernel",
    "build:sandbox:win": "node scripts/build-sandbox-win.mjs",
    "predev": "npm run build:kernel",
    "pretest": "npm run build:kernel",
    "dev": "concurrently -k \"tsc -p kernel --watch --preserveWatchOutput\" \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=http://localhost:5173 node scripts/watch-electron.mjs\"",
    "build": "npm run build:kernel && vite build",
    "start": "npm run build && electron .",
    "test": "cross-env FLYT_SANDBOX_MODE=danger-full-access node --test \"tests/**/*.test.js\"",
    "verify:workflow": "cross-env FLYT_SANDBOX_MODE=danger-full-access node --test tests/workflowReliability.test.js",
    "verify:impeccable": "node plugins/impeccable-flyt-plugin/verify-provenance.mjs",
    "stack": "npm run build:kernel --silent && node core/stacklint.js",
    "workflow": "node core/stacklang/cli.js",
    "lint": "npm run stack -- lint",
    "flyt": "node bin/flyt.js",
    "serve": "node bin/flyt.js serve",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.0.1-rc.1",
    "@deepseek-ai/dsh-skill-badge": "0.0.1-rc.1",
    "@electron/asar": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@xyflow/react": "^12.3.6",
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.9",
    "impeccable-flyt-plugin": "file:plugins/impeccable-flyt-plugin",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "bin": {
    "flyt": "bin/flyt.js"
  }
}
