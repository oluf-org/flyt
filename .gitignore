node_modules/
dist/
runs/
.env
settings.json
# Runtime flow store. The four tiered pipelines are built from code
# (core/flowstore.js ensureSeedPipelines), and anything else here is the user's
# own. A flow the app SHIPS is tracked explicitly: `git add -f flows/<id>.flow.yaml`.
flows/
.flyt/
# This repository intentionally ships the two project-local skills exercised by
# learn-from-repo; all other runtime state under .flyt remains ignored.
!.flyt/
.flyt/*
!.flyt/skills/
.flyt/skills/*
!.flyt/skills/reference-transfer.md
!.flyt/skills/skill-authoring.md
# The node library's record of which seeds it has already been offered
# (core/nodestore.js). Per-library runtime state, like a run folder: it names
# whatever templates that particular library holds, including the user's own.
nodes/_system/seeded.json
# Pre-D29 name; kept so a stale directory in an old checkout stays ignored.
.llmflow/
