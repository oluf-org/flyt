node_modules/
# Build output, at the root (vite) and under kernel/ (tsc). Both are built by
# `npm run build`, and `npm test` builds the kernel first.
dist/
runs/
.env
settings.json
# Runtime flow store. The four tiered pipelines are built from code
# (core/flowstore.js compatibility seeding), and anything else here is the user's
# own. A flow the app SHIPS is tracked explicitly: `git add -f flows/<id>.flow.yaml`.
flows/
.flyt/
# Skills are shareable project configuration and are meant to travel with the
# repository (D15) — so the whole directory is tracked, not an allowlist of
# individual files. The allowlist was two filenames, which meant every skill
# written after it was invisible to a Loop worker: the supervisor works in a
# git worktree, a worktree is a checkout, and an untracked file is not in a
# checkout. The task attached the expertise, the run logged `skill_missing`,
# and nobody looked. All other runtime state under .flyt stays ignored.
!.flyt/
.flyt/*
!.flyt/skills/
!.flyt/skills/**
# A plan a task tells a worker to read has to be in the checkout the worker
# gets. A Loop worker works in a git worktree, a worktree is a checkout, and an
# untracked file is not in a checkout — the same trap the skills allowlist fell
# into. Plan documents travel with the repository; task files stay runtime
# state and do not.
!.flyt/backlog/
.flyt/backlog/*
!.flyt/backlog/*-plan.md
# The node library's record of which seeds it has already been offered
# (core/nodestore.js). Per-library runtime state, like a run folder: it names
# whatever templates that particular library holds, including the user's own.
nodes/_system/seeded.json
# Pre-D29 name; kept so a stale directory in an old checkout stays ignored.
.llmflow/
